# Copia este archivo como ".env" (en la misma carpeta Backend) y completa los valores.
# El archivo .env NO se sube a Git: contiene la contraseña de la base de datos.

# Cadena de conexión a PostgreSQL (Supabase). Pídesela al responsable del proyecto.
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/postgres
DATABASE_URL=postgresql://usuario:contrasena@host:6543/postgres

# Opcionales
DEBUG=false
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
